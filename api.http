# TaskHub HTTP request collection
# IntelliJ IDEA HTTP Client / JetBrains HTTP Client syntax
# Run requests only after the session named in the section is implemented.

@baseUrl = http://localhost:8080
@adminToken = replace-with-admin-jwt
@frontendOrigin = http://localhost:3000

### Session 1 - Actuator discovery
GET {{baseUrl}}/actuator
Accept: application/json

### Session 1 - Health check (expected: 200 and status UP)
GET {{baseUrl}}/actuator/health
Accept: application/json

### Session 2 - Register a user
POST {{baseUrl}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "email": "ada@example.com",
  "username": "ada",
  "password": "ExampleOnly!123"
}

> {%
    client.global.set("assigneeId", response.body.id);
%}

### Session 2 - Log in
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "ada@example.com",
  "password": "ExampleOnly!123"
}

> {%
    client.global.set("token", response.body.accessToken);
%}

### Session 1 contract under Session 2 security (run after login; expected: 404)
GET {{baseUrl}}/api/does-not-exist
Authorization: Bearer {{token}}
Accept: application/problem+json

### Session 2 - Unauthorized request check (expected: 401)
GET {{baseUrl}}/api/projects?page=0&size=20
Accept: application/json

### Session 2 - List projects
GET {{baseUrl}}/api/projects?page=0&size=20
Authorization: Bearer {{token}}
Accept: application/json

### Session 2 - Create a project (expected: 201 with Location header)
POST {{baseUrl}}/api/projects
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "name": "TaskHub course",
  "description": "Track the eight TaskHub delivery sessions"
}

> {%
    client.global.set("projectId", response.body.id);
%}

### Session 2 - Get a project
GET {{baseUrl}}/api/projects/{{projectId}}
Authorization: Bearer {{token}}
Accept: application/json

### Session 2 - Update a project
PUT {{baseUrl}}/api/projects/{{projectId}}
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "name": "TaskHub delivery",
  "description": "Track implementation and review checkpoints"
}

### Session 2 - List tasks in a project
GET {{baseUrl}}/api/projects/{{projectId}}/tasks?page=0&size=20
Authorization: Bearer {{token}}
Accept: application/json

### Session 2 - List tags
GET {{baseUrl}}/api/tags?page=0&size=20
Authorization: Bearer {{token}}
Accept: application/json

### Session 2 - Create a tag
POST {{baseUrl}}/api/tags
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "name": "backend",
  "color": "#2563EB"
}

> {%
    client.global.set("tagId", response.body.id);
%}

### Session 2 - Create a task in a project (expected: 201)
POST {{baseUrl}}/api/projects/{{projectId}}/tasks
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "title": "Bootstrap the Maven reactor",
  "description": "Create the API, proto, and notification modules",
  "status": "TODO",
  "priority": "HIGH",
  "dueDate": "2026-08-01",
  "assigneeId": {{assigneeId}},
  "tagIds": [{{tagId}}]
}

> {%
    client.global.set("taskId", response.body.id);
%}

### Session 2 - Get a task
GET {{baseUrl}}/api/tasks/{{taskId}}
Authorization: Bearer {{token}}
Accept: application/json

### Session 2 - Update a task
PUT {{baseUrl}}/api/tasks/{{taskId}}
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "title": "Bootstrap the Maven reactor",
  "description": "Build and verify all three modules",
  "status": "IN_PROGRESS",
  "priority": "HIGH",
  "dueDate": "2026-08-01",
  "assigneeId": {{assigneeId}},
  "tagIds": [{{tagId}}]
}

### Session 2 - Invalid task validation check (expected: 400)
POST {{baseUrl}}/api/projects/{{projectId}}/tasks
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/problem+json

{
  "title": "",
  "status": "NOT_A_STATUS",
  "priority": "URGENT"
}

### Session 2 - List users as ADMIN
GET {{baseUrl}}/api/users?page=0&size=20
Authorization: Bearer {{adminToken}}
Accept: application/json

### Session 2 - USER forbidden from admin endpoint (expected: 403)
GET {{baseUrl}}/api/users?page=0&size=20
Authorization: Bearer {{token}}
Accept: application/problem+json

### Session 2 - CORS preflight
OPTIONS {{baseUrl}}/api/projects
Origin: {{frontendOrigin}}
Access-Control-Request-Method: POST
Access-Control-Request-Headers: authorization,content-type

### Session 2 - OpenAPI document
GET {{baseUrl}}/v3/api-docs
Accept: application/json

### Session 2 - Swagger UI
GET {{baseUrl}}/swagger-ui.html
Accept: text/html

### Session 2 - Delete a task (expected: 204)
DELETE {{baseUrl}}/api/tasks/{{taskId}}
Authorization: Bearer {{token}}

### Session 2 - Delete a project (expected: 204)
DELETE {{baseUrl}}/api/projects/{{projectId}}
Authorization: Bearer {{token}}

### Session 8 - Prometheus metrics
GET {{baseUrl}}/actuator/prometheus
Accept: text/plain
